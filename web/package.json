{
  "name": "chess-alkkagi-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portable": "tsc --noEmit && vite build --mode portable && node src/tools/finalize-portable-build.mjs",
    "preview": "vite preview",
    "check:piece-stats": "node src/tools/strategy-deck-headless-check.mjs && node src/tools/piece-stat-adapter-headless-check.mjs && node src/tools/piece-preview-contract-check.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@dimforge/rapier3d-compat": "0.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "meshoptimizer": "1.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
